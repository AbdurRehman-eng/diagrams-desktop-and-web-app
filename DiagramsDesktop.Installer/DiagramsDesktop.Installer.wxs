<?xml version="1.0" encoding="UTF-8"?>
<!--
  WiX v4 MSI Installer for GML Diagrams
  Build with: dotnet build DiagramsDesktop.Installer\DiagramsDesktop.Installer.wixproj -c Release
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">

  <Package
    Name="GML Diagrams"
    Manufacturer="GML"
    Version="1.0.0.0"
    UpgradeCode="3F8D1A2B-4C5E-6F7A-8B9C-0D1E2F3A4B5C"
    Language="1033"
    Codepage="1252"
    InstallerVersion="500"
    Compressed="yes">

    <!-- Upgrade: remove older version before installing new one -->
    <MajorUpgrade
      DowngradeErrorMessage="A newer version of [ProductName] is already installed."
      Schedule="afterInstallInitialize" />

    <!-- Embed all cabinet files directly in the MSI -->
    <MediaTemplate EmbedCab="yes" />

    <!-- WiX standard GUI with directory picker -->
    <ui:WixUI Id="WixUI_InstallDir" />
    <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />
    <WixVariable Id="WixUILicenseRtf" Value="License.rtf" />

    <!-- ═══════════════════════════════════════
         DIRECTORY LAYOUT
         ═══════════════════════════════════════ -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="GML Diagrams" />
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppMenuFolder" Name="GML Diagrams" />
    </StandardDirectory>

    <StandardDirectory Id="DesktopFolder" />

    <!-- ═══════════════════════════════════════
         SHORTCUT COMPONENTS
         NOTE: The main exe and all publish files are
         handled entirely by PublishFilesGroup (harvested).
         We only manually define shortcut components here.
         ═══════════════════════════════════════ -->
    <ComponentGroup Id="StartMenuGroup" Directory="AppMenuFolder">
      <Component Id="StartMenuShortcut" Guid="B2C3D4E5-F6A7-8B9C-0D1E-F2A3B4C5D6E7">
        <Shortcut Id="StartMenuShortcutId"
                  Name="GML Diagrams"
                  Description="GML Diagrams Diagramming Tool"
                  Target="[INSTALLFOLDER]GMLDiagrams.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveAppMenuFolder" Directory="AppMenuFolder" On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\GML\GMLDiagrams"
                       Name="installed"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <ComponentGroup Id="DesktopShortcutGroup" Directory="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="C3D4E5F6-A7B8-9C0D-1E2F-A3B4C5D6E7F8">
        <Shortcut Id="DesktopShortcutId"
                  Name="GML Diagrams"
                  Description="GML Diagrams Diagramming Tool"
                  Target="[INSTALLFOLDER]GMLDiagrams.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveDesktopFolder" Directory="DesktopFolder" On="uninstall" />
        <RegistryValue Root="HKCU"
                       Key="Software\GML\GMLDiagrams"
                       Name="desktop"
                       Type="integer"
                       Value="1"
                       KeyPath="yes" />
      </Component>
    </ComponentGroup>

    <!-- ═══════════════════════════════════════
         FEATURE DEFINITION
         PublishFilesGroup is generated by HarvestDirectory
         in DiagramsDesktop.Installer.wixproj
         ═══════════════════════════════════════ -->
    <Feature Id="ProductFeature" Title="GML Diagrams" Level="1">
      <ComponentGroupRef Id="StartMenuGroup" />
      <ComponentGroupRef Id="DesktopShortcutGroup" />
      <ComponentGroupRef Id="PublishFilesGroup" />
    </Feature>

  </Package>

</Wix>
