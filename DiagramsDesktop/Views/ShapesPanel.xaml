<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DiagramsDesktop.ViewModels"
             xmlns:models="clr-namespace:DiagramsDesktop.Models"
             xmlns:views="clr-namespace:DiagramsDesktop.Views"
             x:Class="DiagramsDesktop.Views.ShapesPanel"
             x:DataType="vm:ShapesPanelViewModel"
             WidthRequest="{Binding PanelWidth}">

    <!-- Outer: fixed-width panel + collapse toggle sits outside -->
    <Grid ColumnDefinitions="Auto, Auto" BackgroundColor="#f8fafc">

        <!-- ── Panel body (collapses to zero width) ─────────────────────── -->
        <Border Grid.Column="0"
                WidthRequest="230"
                StrokeThickness="0,0,1,0"
                Stroke="#e2e8f0"
                BackgroundColor="#f8fafc"
                IsVisible="{Binding IsExpanded}">

            <Grid RowDefinitions="Auto, Auto, Auto, Auto, *">

                <!-- Row 0: Header ────────────────────────────────────────── -->
                <Grid Grid.Row="0"
                      ColumnDefinitions="*, Auto"
                      BackgroundColor="#f1f5f9"
                      Padding="14,10">
                    <Label Text="SHAPES"
                           FontSize="11"
                           FontAttributes="Bold"
                           CharacterSpacing="1.5"
                           TextColor="#475569"
                           VerticalOptions="Center" />
                    <Button Grid.Column="1"
                            Command="{Binding ToggleCollapseCommand}"
                            Text="‹"
                            FontSize="16"
                            TextColor="#64748b"
                            BackgroundColor="Transparent"
                            BorderWidth="0"
                            WidthRequest="28"
                            HeightRequest="28"
                            Padding="0"
                            CornerRadius="4" />
                </Grid>

                <!-- Row 1: Search ────────────────────────────────────────── -->
                <Border Grid.Row="1"
                        StrokeShape="RoundRectangle 6"
                        StrokeThickness="1"
                        Stroke="#e2e8f0"
                        Margin="10,8,10,4"
                        Padding="6,0"
                        BackgroundColor="#ffffff">
                    <Grid ColumnDefinitions="Auto, *, Auto">
                        <!-- Search icon -->
                        <Label Grid.Column="0"
                               Text="🔍"
                               FontSize="11"
                               TextColor="#94a3b8"
                               VerticalOptions="Center"
                               Margin="0,0,4,0" />
                        <!-- Input -->
                        <Entry Grid.Column="1"
                               Text="{Binding SearchText}"
                               Placeholder="Search shapes…"
                               FontSize="12"
                               TextColor="#1e293b"
                               PlaceholderColor="#94a3b8"
                               BackgroundColor="Transparent"
                               HeightRequest="32" />
                        <!-- Clear (✕) button — only visible when text present -->
                        <Button Grid.Column="2"
                                Command="{Binding ClearSearchCommand}"
                                IsVisible="{Binding SearchHasText}"
                                Text="✕"
                                FontSize="10"
                                TextColor="#94a3b8"
                                BackgroundColor="Transparent"
                                BorderWidth="0"
                                WidthRequest="24"
                                HeightRequest="24"
                                Padding="0"
                                CornerRadius="12"
                                VerticalOptions="Center" />
                    </Grid>
                </Border>

                <!-- Row 2: Categories label + list ───────────────────────── -->
                <Grid Grid.Row="2" RowDefinitions="Auto, Auto">
                    <!-- "Categories" label -->
                    <Label Grid.Row="0"
                           Text="Categories"
                           FontSize="10"
                           CharacterSpacing="0.8"
                           TextColor="#94a3b8"
                           Margin="14,6,14,4" />

                    <!-- Category rows -->
                    <CollectionView Grid.Row="1"
                                    ItemsSource="{Binding Categories}"
                                    SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                                    SelectionMode="Single">
                        <CollectionView.ItemsLayout>
                            <LinearItemsLayout Orientation="Vertical" ItemSpacing="2" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:ShapeCategory">
                                <Grid ColumnDefinitions="Auto, *, Auto"
                                      Padding="12,7"
                                      MinimumHeightRequest="36">

                                    <VisualStateManager.VisualStateGroups>
                                        <VisualStateGroup Name="CommonStates">
                                            <VisualState Name="Normal">
                                                <VisualState.Setters>
                                                    <Setter Property="BackgroundColor" Value="Transparent" />
                                                </VisualState.Setters>
                                            </VisualState>
                                            <VisualState Name="Selected">
                                                <VisualState.Setters>
                                                    <Setter Property="BackgroundColor" Value="#e0e7ff" />
                                                </VisualState.Setters>
                                            </VisualState>
                                        </VisualStateGroup>
                                    </VisualStateManager.VisualStateGroups>

                                    <!-- Category icon -->
                                    <views:ShapeIconView Grid.Column="0"
                                                         ShapeType="{Binding IconType}"
                                                         ColorHex="{Binding IconColor}"
                                                         WidthRequest="20"
                                                         HeightRequest="20"
                                                         VerticalOptions="Center"
                                                         Margin="0,0,8,0" />
                                    <!-- Category name -->
                                    <Label Grid.Column="1"
                                           Text="{Binding Name}"
                                           FontSize="13"
                                           TextColor="#334155"
                                           VerticalOptions="Center" />
                                    <!-- Count badge / "Soon" badge -->
                                    <Border Grid.Column="2"
                                            StrokeShape="RoundRectangle 10"
                                            StrokeThickness="0"
                                            BackgroundColor="{Binding BadgeColor}"
                                            Padding="6,2"
                                            VerticalOptions="Center">
                                        <Label Text="{Binding BadgeText}"
                                               FontSize="10"
                                               TextColor="{Binding BadgeTextColor}" />
                                    </Border>
                                </Grid>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>
                </Grid>

                <!-- Splitter / Divider ────────────────────────────────────── -->
                <BoxView Grid.Row="3"
                         HeightRequest="1"
                         Color="#e2e8f0"
                         VerticalOptions="Start"
                         Margin="10,6" />

                <!-- Row 4 (*, bottom): Shape items area ──────────────────── -->
                <Grid Grid.Row="4">
                    <!-- Standard items grid -->
                    <CollectionView ItemsSource="{Binding FilteredItems}"
                                    SelectionMode="None"
                                    IsVisible="{Binding IsStandardCategorySelected}"
                                    Margin="8,16,8,8">
                        <CollectionView.ItemsLayout>
                            <GridItemsLayout Orientation="Vertical" Span="2"
                                             HorizontalItemSpacing="8"
                                             VerticalItemSpacing="8" />
                        </CollectionView.ItemsLayout>
                        <CollectionView.ItemTemplate>
                            <DataTemplate x:DataType="models:ShapeLibraryItem">
                                <Border StrokeThickness="1"
                                        Stroke="#e2e8f0"
                                        StrokeShape="RoundRectangle 8"
                                        BackgroundColor="#ffffff"
                                        Padding="6"
                                        HeightRequest="82">

                                    <Border.GestureRecognizers>
                                        <DragGestureRecognizer DragStarting="OnDragStarting" />
                                    </Border.GestureRecognizers>

                                    <Grid RowDefinitions="*, Auto" RowSpacing="4">
                                        <views:ShapeIconView Grid.Row="0"
                                                             ShapeType="{Binding Type}"
                                                             ColorHex="{Binding FillColor}"
                                                             WidthRequest="36"
                                                             HeightRequest="36"
                                                             HorizontalOptions="Center"
                                                             VerticalOptions="Center" />
                                        <Label Grid.Row="1"
                                               Text="{Binding Label}"
                                               FontSize="10"
                                               TextColor="#475569"
                                               HorizontalOptions="Center"
                                               HorizontalTextAlignment="Center"
                                               MaxLines="2"
                                               LineBreakMode="TailTruncation" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </CollectionView.ItemTemplate>
                    </CollectionView>

                    <!-- Coming Soon placeholder -->
                    <VerticalStackLayout IsVisible="{Binding IsPlaceholderCategorySelected}"
                                         VerticalOptions="Center"
                                         HorizontalOptions="Center"
                                         Spacing="10"
                                         Padding="20"
                                         Margin="0,40,0,0">
                        <Label Text="🚧" FontSize="32" HorizontalOptions="Center" />
                        <Label Text="{Binding PlaceholderMessage}"
                               FontSize="13"
                               TextColor="#64748b"
                               HorizontalTextAlignment="Center"
                               HorizontalOptions="Center" />
                    </VerticalStackLayout>
                </Grid>
            </Grid>
        </Border>

        <!-- ── Collapse/Expand toggle tab (always visible) ──────────────── -->
        <Border Grid.Column="1"
                WidthRequest="18"
                StrokeThickness="0,0,1,0"
                Stroke="#e2e8f0"
                BackgroundColor="#f1f5f9"
                VerticalOptions="Fill">
            <Button Command="{Binding ToggleCollapseCommand}"
                    Text="{Binding ToggleButtonText}"
                    FontSize="14"
                    TextColor="#64748b"
                    BackgroundColor="Transparent"
                    BorderWidth="0"
                    Padding="0"
                    CornerRadius="0"
                    VerticalOptions="Start"
                    Margin="0,60,0,0" />
        </Border>

    </Grid>
</ContentView>
