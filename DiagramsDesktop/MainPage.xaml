<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:DiagramsDesktop.ViewModels"
             xmlns:models="clr-namespace:DiagramsDesktop.Models"
             xmlns:views="clr-namespace:DiagramsDesktop.Views"
             x:Class="DiagramsDesktop.MainPage"
             x:DataType="vm:MainPageViewModel"
             Title="DiagramEngine">

    <!-- Root Grid: Toolbar / Workspace / Status bar -->
    <Grid RowDefinitions="Auto, *, Auto">

        <!-- ═══════════════════════════════════════════════════════════════
             Row 0: Two-row Toolbar
             ═══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="0"
                StrokeThickness="0,0,0,1"
                Stroke="#e2e8f0"
                BackgroundColor="#ffffff">
            <VerticalStackLayout Spacing="0">

                <!-- Toolbar Row 1: Brand + Tool Buttons + Zoom -->
                <Grid ColumnDefinitions="Auto, *, Auto"
                      Padding="14,8">

                    <!-- Brand (left) -->
                    <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                        <Label Text="⬛" FontSize="20" TextColor="#6366f1" VerticalOptions="Center" />
                        <Label Text="DiagramEngine"
                               FontSize="15"
                               FontAttributes="Bold"
                               TextColor="#1e293b"
                               VerticalOptions="Center" />
                        <Border StrokeShape="RoundRectangle 4"
                                StrokeThickness="0"
                                BackgroundColor="#e0e7ff"
                                Padding="5,1">
                            <Label Text="M1" FontSize="10" TextColor="#4f46e5" />
                        </Border>
                    </HorizontalStackLayout>

                    <!-- Tool + Zoom controls (center) -->
                    <HorizontalStackLayout Grid.Column="1"
                                           Spacing="4"
                                           HorizontalOptions="Center"
                                           VerticalOptions="Center">

                        <!-- Undo / Redo -->
                        <Button Command="{Binding UndoCommand}"
                                Text="↩"
                                FontSize="15"
                                TextColor="#64748b"
                                BackgroundColor="#f8fafc"
                                BorderColor="#e2e8f0"
                                BorderWidth="1"
                                WidthRequest="34" HeightRequest="34"
                                Padding="0" CornerRadius="6"
                                ToolTipProperties.Text="Undo" />
                        <Button Command="{Binding RedoCommand}"
                                Text="↪"
                                FontSize="15"
                                TextColor="#64748b"
                                BackgroundColor="#f8fafc"
                                BorderColor="#e2e8f0"
                                BorderWidth="1"
                                WidthRequest="34" HeightRequest="34"
                                Padding="0" CornerRadius="6"
                                ToolTipProperties.Text="Redo" />

                        <!-- Separator -->
                        <BoxView WidthRequest="1" HeightRequest="22" Color="#e2e8f0"
                                 VerticalOptions="Center" Margin="4,0" />

                        <!-- Select / Connect tool toggle -->
                        <Button Command="{Binding SelectToolCommand}"
                                Text="Select"
                                FontSize="12"
                                TextColor="{Binding IsSelectToolActive, Converter={x:Static views:BoolToColorConverter.Instance}, ConverterParameter='#4f46e5|#64748b'}"
                                BackgroundColor="{Binding IsSelectToolActive, Converter={x:Static views:BoolToColorConverter.Instance}, ConverterParameter='#e0e7ff|#f8fafc'}"
                                BorderColor="{Binding IsSelectToolActive, Converter={x:Static views:BoolToColorConverter.Instance}, ConverterParameter='#6366f1|#e2e8f0'}"
                                BorderWidth="1"
                                Padding="12,0" HeightRequest="34"
                                CornerRadius="6" />
                        <Button Command="{Binding ConnectToolCommand}"
                                Text="Connect"
                                FontSize="12"
                                TextColor="{Binding IsConnectToolActive, Converter={x:Static views:BoolToColorConverter.Instance}, ConverterParameter='#4f46e5|#64748b'}"
                                BackgroundColor="{Binding IsConnectToolActive, Converter={x:Static views:BoolToColorConverter.Instance}, ConverterParameter='#e0e7ff|#f8fafc'}"
                                BorderColor="{Binding IsConnectToolActive, Converter={x:Static views:BoolToColorConverter.Instance}, ConverterParameter='#6366f1|#e2e8f0'}"
                                BorderWidth="1"
                                Padding="12,0" HeightRequest="34"
                                CornerRadius="6" />

                        <!-- Separator -->
                        <BoxView WidthRequest="1" HeightRequest="22" Color="#e2e8f0"
                                 VerticalOptions="Center" Margin="4,0" />

                        <!-- Zoom controls -->
                        <Button Command="{Binding ZoomOutCommand}"
                                Text="−"
                                FontSize="16" TextColor="#64748b"
                                BackgroundColor="#f8fafc" BorderColor="#e2e8f0" BorderWidth="1"
                                WidthRequest="34" HeightRequest="34" Padding="0" CornerRadius="6"
                                ToolTipProperties.Text="Zoom Out" />
                        <Border StrokeShape="RoundRectangle 6"
                                Stroke="#e2e8f0"
                                BackgroundColor="#f8fafc"
                                Padding="10,0"
                                MinimumWidthRequest="52"
                                HeightRequest="34"
                                VerticalOptions="Center">
                            <Label Text="{Binding ZoomPercent}"
                                   FontSize="12"
                                   TextColor="#334155"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
                        </Border>
                        <Button Command="{Binding ZoomInCommand}"
                                Text="+"
                                FontSize="16" TextColor="#64748b"
                                BackgroundColor="#f8fafc" BorderColor="#e2e8f0" BorderWidth="1"
                                WidthRequest="34" HeightRequest="34" Padding="0" CornerRadius="6"
                                ToolTipProperties.Text="Zoom In" />
                        <Button Command="{Binding FitToScreenCommand}"
                                Text="⛶ Fit"
                                FontSize="12" TextColor="#64748b"
                                BackgroundColor="#f8fafc" BorderColor="#e2e8f0" BorderWidth="1"
                                Padding="10,0" HeightRequest="34" CornerRadius="6"
                                ToolTipProperties.Text="Fit to Screen" />

                        <!-- Separator -->
                        <BoxView WidthRequest="1" HeightRequest="22" Color="#e2e8f0"
                                 VerticalOptions="Center" Margin="4,0" />

                        <!-- Settings Gear Button -->
                        <Button Command="{Binding TogglePropertiesModalCommand}"
                                Text="⚙ Settings"
                                FontSize="12" TextColor="#475569"
                                BackgroundColor="#f8fafc" BorderColor="#e2e8f0" BorderWidth="1"
                                Padding="12,0" HeightRequest="34" CornerRadius="6"
                                ToolTipProperties.Text="Canvas Settings &amp; Variables" />
                    </HorizontalStackLayout>

                    <!-- Diagram title (right) -->
                    <HorizontalStackLayout Grid.Column="2" Spacing="6" VerticalOptions="Center">
                        <Entry Text="{Binding DiagramTitle}"
                               FontSize="13"
                               TextColor="#1e293b"
                               WidthRequest="180"
                               Placeholder="Diagram title…"
                               BackgroundColor="Transparent"
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>
                </Grid>

                <!-- Toolbar Row 2: File / Edit / Save menus -->
                <BoxView HeightRequest="1" Color="#f1f5f9" />
                <HorizontalStackLayout Spacing="0" Padding="10,2">

                    <!-- File menu -->
                    <HorizontalStackLayout Spacing="2">
                        <Button Command="{Binding NewDiagramCommand}"
                                Text="New"
                                FontSize="12" TextColor="#475569"
                                BackgroundColor="Transparent" BorderWidth="0"
                                Padding="10,4" HeightRequest="30" CornerRadius="4" />
                        <Button Command="{Binding LoadDiagramCommand}"
                                Text="Open DB"
                                FontSize="12" TextColor="#475569"
                                BackgroundColor="Transparent" BorderWidth="0"
                                Padding="10,4" HeightRequest="30" CornerRadius="4" />
                        <Button Command="{Binding SaveDiagramCommand}"
                                Text="💾 Save"
                                FontSize="12" TextColor="#ffffff"
                                BackgroundColor="#6366f1" BorderWidth="0"
                                Padding="12,4" HeightRequest="30" CornerRadius="4" />
                        <Button Command="{Binding ImportJsonCommand}"
                                Text="Import JSON"
                                FontSize="12" TextColor="#475569"
                                BackgroundColor="Transparent" BorderWidth="0"
                                Padding="10,4" HeightRequest="30" CornerRadius="4" />
                        <Button Command="{Binding ExportJsonCommand}"
                                Text="Export JSON"
                                FontSize="12" TextColor="#475569"
                                BackgroundColor="Transparent" BorderWidth="0"
                                Padding="10,4" HeightRequest="30" CornerRadius="4" />
                    </HorizontalStackLayout>
                </HorizontalStackLayout>
            </VerticalStackLayout>
        </Border>

        <!-- ═══════════════════════════════════════════════════════════════
             Row 1: Main Workspace
             ═══════════════════════════════════════════════════════════════ -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="{Binding Source={x:Reference ShapesSidebar}, Path=BindingContext.PanelWidth, FallbackValue=248, TargetNullValue=248}" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Column 0: Shapes Panel -->
            <views:ShapesPanel x:Name="ShapesSidebar"
                               Grid.Column="0"
                               HorizontalOptions="Start"
                               VerticalOptions="Fill"
                               BindingContext="{Binding ShapesPanelVM}" />

            <!-- Column 1: Canvas -->
            <views:CanvasView x:Name="MainCanvasView"
                              Grid.Column="1"
                              Diagram="{Binding ActiveDiagram}"
                              SelectedShapeId="{Binding SelectedShapeId, Mode=TwoWay}"
                              SizeChanged="OnCanvasViewSizeChanged" />

            <!-- Column 2: Properties Panel (selected shape) -->
            <Border Grid.Column="2"
                    WidthRequest="250"
                    StrokeThickness="1,0,0,0"
                    Stroke="#e2e8f0"
                    BackgroundColor="#ffffff"
                    IsVisible="{Binding HasSelectedShape}"
                    Padding="15">

                <ScrollView>
                    <VerticalStackLayout Spacing="14">
                        <!-- Panel header -->
                        <Label Text="Properties"
                               FontSize="13"
                               FontAttributes="Bold"
                               CharacterSpacing="0.5"
                               TextColor="#1e293b"
                               Margin="0,0,0,4" />

                        <!-- Type (read-only) -->
                        <VerticalStackLayout Spacing="3">
                            <Label Text="Type" FontSize="10" TextColor="#94a3b8" />
                            <Label Text="{Binding SelectedShape.Type}"
                                   FontSize="13" FontAttributes="Italic"
                                   TextColor="#475569" />
                        </VerticalStackLayout>

                        <!-- Label -->
                        <VerticalStackLayout Spacing="3">
                            <Label Text="Label" FontSize="10" TextColor="#94a3b8" />
                            <Border StrokeShape="RoundRectangle 6"
                                    Stroke="#e2e8f0" BackgroundColor="#f8fafc" Padding="8,4">
                                <Entry Text="{Binding SelectedShape.Label}"
                                       FontSize="13" TextColor="#1e293b"
                                       BackgroundColor="Transparent"
                                       TextChanged="OnPropertyModified" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- World X -->
                        <VerticalStackLayout Spacing="3">
                            <Label Text="World X" FontSize="10" TextColor="#94a3b8" />
                            <Border StrokeShape="RoundRectangle 6"
                                    Stroke="#e2e8f0" BackgroundColor="#f8fafc" Padding="8,4">
                                <Entry Text="{Binding SelectedShape.WorldX}"
                                       Keyboard="Numeric"
                                       FontSize="13" TextColor="#1e293b"
                                       BackgroundColor="Transparent"
                                       TextChanged="OnPropertyModified" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- World Y -->
                        <VerticalStackLayout Spacing="3">
                            <Label Text="World Y" FontSize="10" TextColor="#94a3b8" />
                            <Border StrokeShape="RoundRectangle 6"
                                    Stroke="#e2e8f0" BackgroundColor="#f8fafc" Padding="8,4">
                                <Entry Text="{Binding SelectedShape.WorldY}"
                                       Keyboard="Numeric"
                                       FontSize="13" TextColor="#1e293b"
                                       BackgroundColor="Transparent"
                                       TextChanged="OnPropertyModified" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Width -->
                        <VerticalStackLayout Spacing="3">
                            <Label Text="Width" FontSize="10" TextColor="#94a3b8" />
                            <Border StrokeShape="RoundRectangle 6"
                                    Stroke="#e2e8f0" BackgroundColor="#f8fafc" Padding="8,4">
                                <Entry Text="{Binding SelectedShape.Width}"
                                       Keyboard="Numeric"
                                       FontSize="13" TextColor="#1e293b"
                                       BackgroundColor="Transparent"
                                       TextChanged="OnPropertyModified" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Height -->
                        <VerticalStackLayout Spacing="3">
                            <Label Text="Height" FontSize="10" TextColor="#94a3b8" />
                            <Border StrokeShape="RoundRectangle 6"
                                    Stroke="#e2e8f0" BackgroundColor="#f8fafc" Padding="8,4">
                                <Entry Text="{Binding SelectedShape.Height}"
                                       Keyboard="Numeric"
                                       FontSize="13" TextColor="#1e293b"
                                       BackgroundColor="Transparent"
                                       TextChanged="OnPropertyModified" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Fill Color swatches -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Fill Color" FontSize="10" TextColor="#94a3b8" />
                            <Grid ColumnDefinitions="*,*,*,*,*,*" ColumnSpacing="6">
                                <Border x:Name="SwatchIndigo" Grid.Column="0"
                                        StrokeShape="RoundRectangle 4"
                                        StrokeThickness="1" Stroke="#e2e8f0"
                                        BackgroundColor="#6366f1" HeightRequest="24">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnFillColorTapped" CommandParameter="#6366f1" />
                                    </Border.GestureRecognizers>
                                </Border>
                                <Border Grid.Column="1"
                                        StrokeShape="RoundRectangle 4"
                                        StrokeThickness="1" Stroke="#e2e8f0"
                                        BackgroundColor="#10b981" HeightRequest="24">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnFillColorTapped" CommandParameter="#10b981" />
                                    </Border.GestureRecognizers>
                                </Border>
                                <Border Grid.Column="2"
                                        StrokeShape="RoundRectangle 4"
                                        StrokeThickness="1" Stroke="#e2e8f0"
                                        BackgroundColor="#f59e0b" HeightRequest="24">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnFillColorTapped" CommandParameter="#f59e0b" />
                                    </Border.GestureRecognizers>
                                </Border>
                                <Border Grid.Column="3"
                                        StrokeShape="RoundRectangle 4"
                                        StrokeThickness="1" Stroke="#e2e8f0"
                                        BackgroundColor="#f43f5e" HeightRequest="24">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnFillColorTapped" CommandParameter="#f43f5e" />
                                    </Border.GestureRecognizers>
                                </Border>
                                <Border Grid.Column="4"
                                        StrokeShape="RoundRectangle 4"
                                        StrokeThickness="1" Stroke="#e2e8f0"
                                        BackgroundColor="#0ea5e9" HeightRequest="24">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnFillColorTapped" CommandParameter="#0ea5e9" />
                                    </Border.GestureRecognizers>
                                </Border>
                                <Border Grid.Column="5"
                                        StrokeShape="RoundRectangle 4"
                                        StrokeThickness="1" Stroke="#e2e8f0"
                                        BackgroundColor="#64748b" HeightRequest="24">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnFillColorTapped" CommandParameter="#64748b" />
                                    </Border.GestureRecognizers>
                                </Border>
                            </Grid>
                            <!-- Hex text input -->
                            <Border StrokeShape="RoundRectangle 6"
                                    Stroke="#e2e8f0" BackgroundColor="#f8fafc" Padding="8,4">
                                <Entry Text="{Binding SelectedShape.FillColor}"
                                       FontSize="12" TextColor="#475569"
                                       BackgroundColor="Transparent"
                                       TextChanged="OnPropertyModified"
                                       Placeholder="#6366f1" />
                            </Border>
                        </VerticalStackLayout>

                         <!-- Delete button -->
                        <Button Text="Delete Shape"
                                Clicked="OnDeleteShapeClicked"
                                BackgroundColor="#ef4444"
                                TextColor="#ffffff"
                                Margin="0,8,0,0"
                                HeightRequest="36"
                                CornerRadius="6" />
                    </VerticalStackLayout>
                </ScrollView>
            </Border>

            <!-- Column 2: Properties Panel (selected circle on container) -->
            <Border Grid.Column="2"
                    WidthRequest="250"
                    StrokeThickness="1,0,0,0"
                    Stroke="#e2e8f0"
                    BackgroundColor="#ffffff"
                    IsVisible="{Binding HasSelectedCircleOnContainer}"
                    Padding="15">
                <ScrollView>
                    <VerticalStackLayout Spacing="14">
                        <!-- Panel header -->
                        <Label Text="Edge Device Properties"
                               FontSize="13"
                               FontAttributes="Bold"
                               CharacterSpacing="0.5"
                               TextColor="#1e293b"
                               Margin="0,0,0,4" />

                        <!-- Device Type (read-only) -->
                        <VerticalStackLayout Spacing="3">
                            <Label Text="Device Type" FontSize="10" TextColor="#94a3b8" />
                            <Label Text="{Binding SelectedCircleOnContainer.DeviceOnContainerEdgeType}"
                                   FontSize="13" FontAttributes="Italic"
                                   TextColor="#475569" />
                        </VerticalStackLayout>

                        <!-- Label -->
                        <VerticalStackLayout Spacing="3">
                            <Label Text="Label" FontSize="10" TextColor="#94a3b8" />
                            <Border StrokeShape="RoundRectangle 6"
                                    Stroke="#e2e8f0" BackgroundColor="#f8fafc" Padding="8,4">
                                <Entry Text="{Binding SelectedCircleOnContainer.Label}"
                                       FontSize="13" TextColor="#1e293b"
                                       BackgroundColor="Transparent"
                                       TextChanged="OnPropertyModified" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Parent ID (read-only) -->
                        <VerticalStackLayout Spacing="3">
                            <Label Text="Parent VPC Container ID" FontSize="10" TextColor="#94a3b8" />
                            <Label Text="{Binding SelectedCircleOnContainer.ParentContainerID}"
                                   FontSize="11" TextColor="#64748b" />
                        </VerticalStackLayout>

                        <!-- Radius -->
                        <VerticalStackLayout Spacing="3">
                            <Label Text="Radius (Resize)" FontSize="10" TextColor="#94a3b8" />
                            <Border StrokeShape="RoundRectangle 6"
                                    Stroke="#e2e8f0" BackgroundColor="#f8fafc" Padding="8,4">
                                <Entry Text="{Binding SelectedCircleOnContainer.Radius}"
                                       Keyboard="Numeric"
                                       FontSize="13" TextColor="#1e293b"
                                       BackgroundColor="Transparent"
                                       TextChanged="OnPropertyModified" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Edge / Position -->
                        <VerticalStackLayout Spacing="3">
                            <Label Text="Host Edge" FontSize="10" TextColor="#94a3b8" />
                            <Label Text="{Binding SelectedCircleOnContainer.HostEdge}"
                                   FontSize="13" TextColor="#475569" />
                        </VerticalStackLayout>
                        <VerticalStackLayout Spacing="3">
                            <Label Text="Edge Parameter (T)" FontSize="10" TextColor="#94a3b8" />
                            <Label Text="{Binding SelectedCircleOnContainer.EdgeParameterT, StringFormat='{0:F2}'}"
                                   FontSize="13" TextColor="#475569" />
                        </VerticalStackLayout>

                        <!-- Fill Color swatches for COC -->
                        <VerticalStackLayout Spacing="6">
                            <Label Text="Fill Color" FontSize="10" TextColor="#94a3b8" />
                            <Grid ColumnDefinitions="*,*,*,*,*,*" ColumnSpacing="6">
                                <Border Grid.Column="0" StrokeShape="RoundRectangle 4" StrokeThickness="1" Stroke="#e2e8f0" BackgroundColor="#6366f1" HeightRequest="24">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnCocFillColorTapped" CommandParameter="#6366f1" />
                                    </Border.GestureRecognizers>
                                </Border>
                                <Border Grid.Column="1" StrokeShape="RoundRectangle 4" StrokeThickness="1" Stroke="#e2e8f0" BackgroundColor="#10b981" HeightRequest="24">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnCocFillColorTapped" CommandParameter="#10b981" />
                                    </Border.GestureRecognizers>
                                </Border>
                                <Border Grid.Column="2" StrokeShape="RoundRectangle 4" StrokeThickness="1" Stroke="#e2e8f0" BackgroundColor="#f59e0b" HeightRequest="24">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnCocFillColorTapped" CommandParameter="#f59e0b" />
                                    </Border.GestureRecognizers>
                                </Border>
                                <Border Grid.Column="3" StrokeShape="RoundRectangle 4" StrokeThickness="1" Stroke="#e2e8f0" BackgroundColor="#f43f5e" HeightRequest="24">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnCocFillColorTapped" CommandParameter="#f43f5e" />
                                    </Border.GestureRecognizers>
                                </Border>
                                <Border Grid.Column="4" StrokeShape="RoundRectangle 4" StrokeThickness="1" Stroke="#e2e8f0" BackgroundColor="#0ea5e9" HeightRequest="24">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnCocFillColorTapped" CommandParameter="#0ea5e9" />
                                    </Border.GestureRecognizers>
                                </Border>
                                <Border Grid.Column="5" StrokeShape="RoundRectangle 4" StrokeThickness="1" Stroke="#e2e8f0" BackgroundColor="#64748b" HeightRequest="24">
                                    <Border.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnCocFillColorTapped" CommandParameter="#64748b" />
                                    </Border.GestureRecognizers>
                                </Border>
                            </Grid>
                            <!-- Hex text input -->
                            <Border StrokeShape="RoundRectangle 6" Stroke="#e2e8f0" BackgroundColor="#f8fafc" Padding="8,4">
                                <Entry Text="{Binding SelectedCircleOnContainer.FillColor}"
                                       FontSize="12" TextColor="#475569"
                                       BackgroundColor="Transparent"
                                       TextChanged="OnPropertyModified"
                                       Placeholder="#6366f1" />
                            </Border>
                        </VerticalStackLayout>

                        <!-- Delete button -->
                        <Button Text="Delete Edge Device"
                                Clicked="OnDeleteCocClicked"
                                BackgroundColor="#ef4444"
                                TextColor="#ffffff"
                                Margin="0,8,0,0"
                                HeightRequest="36"
                                CornerRadius="6" />
                    </VerticalStackLayout>
                </ScrollView>
            </Border>

            <!-- FLOATING OVERLAY MODAL -->
            <Grid Grid.Column="0" Grid.ColumnSpan="3"
                  BackgroundColor="#80000000"
                  IsVisible="{Binding IsPropertiesModalVisible}"
                  HorizontalOptions="Fill"
                  VerticalOptions="Fill"
                  InputTransparent="False">
                
                <Grid.GestureRecognizers>
                    <TapGestureRecognizer Command="{Binding TogglePropertiesModalCommand}" />
                </Grid.GestureRecognizers>

                <!-- Modal Container -->
                <Border StrokeShape="RoundRectangle 12"
                        StrokeThickness="1"
                        Stroke="#e2e8f0"
                        BackgroundColor="#ffffff"
                        WidthRequest="500"
                        HeightRequest="420"
                        HorizontalOptions="Center"
                        VerticalOptions="Center"
                        Padding="0"
                        InputTransparent="False">
                    
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer /> 
                    </Border.GestureRecognizers>

                    <Grid RowDefinitions="Auto, *, Auto">
                        
                        <!-- Header & Tabs -->
                        <Grid Grid.Row="0" RowDefinitions="Auto, Auto" BackgroundColor="#f8fafc" Padding="20,15,20,0">
                            <!-- Title & Close -->
                            <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,10">
                                <Label Grid.Column="0" Text="Canvas Settings &amp; Variables" FontSize="16" FontAttributes="Bold" TextColor="#1e293b" />
                                <Button Grid.Column="1" Command="{Binding TogglePropertiesModalCommand}" Text="✕" TextColor="#94a3b8" BackgroundColor="Transparent" BorderWidth="0" WidthRequest="32" HeightRequest="32" FontSize="14" Padding="0" CornerRadius="16" />
                            </Grid>

                            <!-- Tab headers -->
                            <HorizontalStackLayout Grid.Row="1" Spacing="20">
                                <!-- Canvas Tab Button -->
                                <Button Command="{Binding SelectModalTabCommand}" CommandParameter="canvas"
                                        Text="Canvas Settings"
                                        FontSize="13"
                                        FontAttributes="Bold"
                                        TextColor="{Binding IsCanvasTabActive, Converter={x:Static views:BoolToColorConverter.Instance}, ConverterParameter='#4f46e5|#64748b'}"
                                        BackgroundColor="Transparent"
                                        BorderWidth="0"
                                        Padding="0,6"
                                        CornerRadius="0" />
                                
                                <!-- Variables Tab Button -->
                                <Button Command="{Binding SelectModalTabCommand}" CommandParameter="variables"
                                        Text="Global Variables"
                                        FontSize="13"
                                        FontAttributes="Bold"
                                        TextColor="{Binding IsVariablesTabActive, Converter={x:Static views:BoolToColorConverter.Instance}, ConverterParameter='#4f46e5|#64748b'}"
                                        BackgroundColor="Transparent"
                                        BorderWidth="0"
                                        Padding="0,6"
                                        CornerRadius="0" />
                            </HorizontalStackLayout>
                        </Grid>

                        <BoxView Grid.Row="0" VerticalOptions="End" HeightRequest="1" Color="#e2e8f0" />

                        <!-- Content Area -->
                        <Grid Grid.Row="1" Margin="20,15">
                            
                            <!-- Tab Content 1: Canvas Settings -->
                            <ScrollView IsVisible="{Binding IsCanvasTabActive}">
                                <VerticalStackLayout Spacing="16">
                                    
                                    <!-- Grid Visibility -->
                                    <Grid ColumnDefinitions="*, Auto">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="Show Canvas Grid" FontSize="13" FontAttributes="Bold" TextColor="#334155" />
                                            <Label Text="Toggle display of the background grid pattern." FontSize="11" TextColor="#94a3b8" />
                                        </VerticalStackLayout>
                                        <Switch Grid.Column="1" IsToggled="{Binding Canvas.GridVisible, Mode=TwoWay}" OnColor="#4f46e5" ThumbColor="#ffffff" />
                                    </Grid>

                                    <!-- Grid Spacing X -->
                                    <Grid ColumnDefinitions="*, Auto">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="Grid Spacing X" FontSize="13" FontAttributes="Bold" TextColor="#334155" />
                                            <Label Text="Horizontal distance between grid lines (px)." FontSize="11" TextColor="#94a3b8" />
                                        </VerticalStackLayout>
                                        <Border Grid.Column="1" StrokeShape="RoundRectangle 6" Stroke="#e2e8f0" Padding="8,4" WidthRequest="100">
                                            <Entry Text="{Binding Canvas.GridSpacingX, Mode=TwoWay}" Keyboard="Numeric" FontSize="13" HorizontalTextAlignment="End" BackgroundColor="Transparent" TextColor="#1e293b" />
                                        </Border>
                                    </Grid>

                                    <!-- Grid Spacing Y -->
                                    <Grid ColumnDefinitions="*, Auto">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="Grid Spacing Y" FontSize="13" FontAttributes="Bold" TextColor="#334155" />
                                            <Label Text="Vertical distance between grid lines (px)." FontSize="11" TextColor="#94a3b8" />
                                        </VerticalStackLayout>
                                        <Border Grid.Column="1" StrokeShape="RoundRectangle 6" Stroke="#e2e8f0" Padding="8,4" WidthRequest="100">
                                            <Entry Text="{Binding Canvas.GridSpacingY, Mode=TwoWay}" Keyboard="Numeric" FontSize="13" HorizontalTextAlignment="End" BackgroundColor="Transparent" TextColor="#1e293b" />
                                        </Border>
                                    </Grid>

                                    <!-- Grid Color -->
                                    <Grid ColumnDefinitions="*, Auto">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="Grid Color" FontSize="13" FontAttributes="Bold" TextColor="#334155" />
                                            <Label Text="Stroke color of grid pattern lines." FontSize="11" TextColor="#94a3b8" />
                                        </VerticalStackLayout>
                                        <Border Grid.Column="1" StrokeShape="RoundRectangle 6" Stroke="#e2e8f0" Padding="8,4" WidthRequest="120">
                                            <Entry Text="{Binding Canvas.GridColor, Mode=TwoWay}" FontSize="13" BackgroundColor="Transparent" TextColor="#1e293b" />
                                        </Border>
                                    </Grid>

                                    <!-- Canvas Background Color -->
                                    <Grid ColumnDefinitions="*, Auto">
                                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                                            <Label Text="Background Color" FontSize="13" FontAttributes="Bold" TextColor="#334155" />
                                            <Label Text="Fill color of the canvas workspace background." FontSize="11" TextColor="#94a3b8" />
                                        </VerticalStackLayout>
                                        <Border Grid.Column="1" StrokeShape="RoundRectangle 6" Stroke="#e2e8f0" Padding="8,4" WidthRequest="120">
                                            <Entry Text="{Binding Canvas.BackgroundColor, Mode=TwoWay}" FontSize="13" BackgroundColor="Transparent" TextColor="#1e293b" />
                                        </Border>
                                    </Grid>

                                </VerticalStackLayout>
                            </ScrollView>

                            <!-- Tab Content 2: Global Variables -->
                            <Grid IsVisible="{Binding IsVariablesTabActive}" RowDefinitions="*, Auto" RowSpacing="12">
                                
                                <CollectionView Grid.Row="0" ItemsSource="{Binding GlobalVariables}">
                                    <CollectionView.EmptyView>
                                        <VerticalStackLayout Spacing="8" VerticalOptions="Center" HorizontalOptions="Center" Padding="0,30">
                                            <Label Text="🏷️" FontSize="28" HorizontalOptions="Center" />
                                            <Label Text="No global variables defined yet." FontSize="12" TextColor="#94a3b8" HorizontalOptions="Center" />
                                        </VerticalStackLayout>
                                    </CollectionView.EmptyView>
                                    <CollectionView.ItemsLayout>
                                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="6" />
                                    </CollectionView.ItemsLayout>
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate x:DataType="models:GlobalVariable">
                                            <Border StrokeShape="RoundRectangle 6" Stroke="#f1f5f9" BackgroundColor="#f8fafc" Padding="10,6">
                                                <Grid ColumnDefinitions="*, *, Auto">
                                                    <Label Grid.Column="0" Text="{Binding Key}" FontSize="13" FontAttributes="Bold" TextColor="#334155" VerticalOptions="Center" />
                                                    <Label Grid.Column="1" Text="{Binding Value}" FontSize="13" TextColor="#64748b" VerticalOptions="Center" />
                                                    <Button Grid.Column="2" 
                                                            Command="{Binding Source={RelativeSource AncestorType={x:Type vm:MainPageViewModel}}, Path=DeleteVariableCommand}"
                                                            CommandParameter="{Binding .}"
                                                            Text="Delete" FontSize="11" TextColor="#ef4444" BackgroundColor="Transparent" Padding="6,2" HeightRequest="26" CornerRadius="4" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>

                                <Border Grid.Row="1" StrokeShape="RoundRectangle 8" Stroke="#e2e8f0" BackgroundColor="#f8fafc" Padding="10" Margin="0,6,0,0">
                                    <Grid ColumnDefinitions="*, *, Auto" ColumnSpacing="8">
                                        <Border Grid.Column="0" StrokeShape="RoundRectangle 4" Stroke="#cbd5e1" BackgroundColor="#ffffff" Padding="6,2">
                                            <Entry Text="{Binding NewVariableKey}" Placeholder="Key" FontSize="12" TextColor="#1e293b" PlaceholderColor="#94a3b8" BackgroundColor="Transparent" HeightRequest="30" />
                                        </Border>
                                        <Border Grid.Column="1" StrokeShape="RoundRectangle 4" Stroke="#cbd5e1" BackgroundColor="#ffffff" Padding="6,2">
                                            <Entry Text="{Binding NewVariableValue}" Placeholder="Value" FontSize="12" TextColor="#1e293b" PlaceholderColor="#94a3b8" BackgroundColor="Transparent" HeightRequest="30" />
                                        </Border>
                                        <Button Grid.Column="2" Command="{Binding AddVariableCommand}" Text="Add" FontSize="12" TextColor="#ffffff" BackgroundColor="#4f46e5" Padding="12,0" HeightRequest="30" CornerRadius="4" />
                                    </Grid>
                                </Border>

                            </Grid>

                        </Grid>

                        <!-- Footer -->
                        <Grid Grid.Row="2" BackgroundColor="#f8fafc" Padding="20,10" ColumnDefinitions="*, Auto">
                            <Label Grid.Column="0" Text="Changes apply immediately" FontSize="11" TextColor="#94a3b8" VerticalOptions="Center" />
                            <Button Grid.Column="1" Command="{Binding TogglePropertiesModalCommand}" Text="Close" FontSize="12" TextColor="#ffffff" BackgroundColor="#1e293b" Padding="16,6" HeightRequest="32" CornerRadius="6" />
                        </Grid>

                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!-- ═══════════════════════════════════════════════════════════════
             Row 2: Status Bar
             ═══════════════════════════════════════════════════════════════ -->
        <Border Grid.Row="2"
                StrokeThickness="0,1,0,0"
                Stroke="#e2e8f0"
                BackgroundColor="#f8fafc"
                Padding="14,5">
            <Grid ColumnDefinitions="Auto, *, Auto">

                <!-- Left: status info -->
                <HorizontalStackLayout Grid.Column="0" Spacing="16">
                    <HorizontalStackLayout Spacing="4">
                        <Label Text="Category:" FontSize="11" TextColor="#94a3b8" VerticalOptions="Center" />
                        <Label Text="{Binding ShapesPanelVM.SelectedCategoryHeader}"
                               FontSize="11" TextColor="#475569" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <BoxView WidthRequest="1" HeightRequest="14" Color="#e2e8f0" VerticalOptions="Center" />
                    <HorizontalStackLayout Spacing="4">
                        <Label Text="World:" FontSize="11" TextColor="#94a3b8" VerticalOptions="Center" />
                        <Label Text="{Binding WorldCoords}"
                               FontSize="11" TextColor="#475569" VerticalOptions="Center" />
                    </HorizontalStackLayout>
                    <BoxView WidthRequest="1" HeightRequest="14" Color="#e2e8f0" VerticalOptions="Center" />
                    <Label Text="{Binding ShapeCount}"
                           FontSize="11" TextColor="#475569" VerticalOptions="Center" />
                </HorizontalStackLayout>

                <!-- Right: zoom % -->
                <HorizontalStackLayout Grid.Column="2" Spacing="6">
                    <Label Text="Zoom:" FontSize="11" TextColor="#94a3b8" VerticalOptions="Center" />
                    <Label Text="{Binding ZoomPercent}"
                           FontSize="11" FontAttributes="Bold"
                           TextColor="#475569" VerticalOptions="Center" />
                </HorizontalStackLayout>
            </Grid>
        </Border>

    </Grid>
</ContentPage>
