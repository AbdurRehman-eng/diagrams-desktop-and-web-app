<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <handlers>
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <!-- 
        SmarterASP / IIS deployment fix:
        - processPath="dotnet" + arguments=".\Antitouch.dll"  → framework-dependent (net8.0)
        - hostingModel="outofprocess"                         → most compatible with shared hosting
        - stdoutLogEnabled="true" + logs folder pre-created  → captures startup errors
        - ASPNETCORE_ENVIRONMENT=Production                   → disables Swagger in prod
      -->
      <aspNetCore processPath="dotnet" arguments=".\Antitouch.dll" stdoutLogEnabled="true" stdoutLogFile=".\logs\stdout" hostingModel="outofprocess">
        <environmentVariables>
          <environmentVariable name="ASPNETCORE_ENVIRONMENT" value="Production" />
        </environmentVariables>
      </aspNetCore>
    </system.webServer>
  </location>
</configuration>